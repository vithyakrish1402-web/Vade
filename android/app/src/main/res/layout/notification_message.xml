<?xml version="1.0" encoding="utf-8"?>
<!--
    Custom notification content — RemoteViews only supports a plain-framework subset of views
    (no Compose, no androidx widgets), so this reimplements the same design as
    MessageNotificationBanner.kt by hand: avatar + unread dot, name (+ "NEW" chip for a first
    message), a lock glyph with generic body copy, and a timestamp. Never decrypted content.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification_card"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp">

            <TextView
                android:id="@+id/notif_avatar_initial"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_notification_avatar"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/vade_notif_text"
                android:text="?" />

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_notification_dot" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/notif_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/vade_notif_text"
                    tools:text="Maya Chen" />

                <TextView
                    android:id="@+id/notif_new_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_notification_chip"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:textStyle="bold"
                    android:textSize="9.5sp"
                    android:textColor="@color/vade_notif_accent_ink"
                    android:text="NEW"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_lock_small"
                    android:tint="@color/vade_notif_faint" />

                <TextView
                    android:id="@+id/notif_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textSize="12.5sp"
                    android:textColor="@color/vade_notif_muted"
                    tools:text="Sent an encrypted message" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/notif_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="11sp"
            android:textColor="@color/vade_notif_faint"
            tools:text="now" />
    </LinearLayout>
</FrameLayout>
