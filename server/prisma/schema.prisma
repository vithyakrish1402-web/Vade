// Prisma Schema for enctxt / private-chat
// Phase 8: Security Hardening, Key Verification & Device Trust

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Minimal system metadata model for connection verification & migration infrastructure
model SystemInfo {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_info")
}

// User Identity Model
model User {
  id                  String               @id @default(uuid())
  username            String               @unique
  email               String               @unique
  passwordHash        String
  displayName         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  devices             Device[]
  conversationMembers ConversationMember[]
  sentMessages        Message[]
  publicKey           PublicKey?

  @@index([username])
  @@index([email])
  @@map("users")
}

// Public Key Distribution Model (Phase 7: E2EE & Phase 8: Status/Lifecycle)
model PublicKey {
  id        String   @id @default(uuid())
  userId    String   @unique
  keyId     String   @unique
  publicKey String   @db.Text
  algorithm String   @default("ECDH-P256")
  status    String   @default("active") // "active" | "revoked" | "superseded"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyId])
  @@map("public_keys")
}

// Device Identity Model (Phase 8: Device Trust & Management)
model Device {
  id         String   @id @default(uuid())
  userId     String
  deviceName String
  platform   String   @default("web")
  keyId      String
  status     String   @default("active") // "active" | "revoked"
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyId])
  @@map("devices")
}

// Authenticated Session Model
model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

// Conversation Model
model Conversation {
  id        String               @id @default(uuid())
  directKey String               @unique // Deterministic sorted pair of user IDs: "idA:idB"
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   ConversationMember[]
  messages  Message[]

  @@index([directKey])
  @@map("conversations")
}

// Conversation Member Model
model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_members")
}

// Encrypted Message Model (Phase 7: End-to-End Encryption)
// Stores ciphertext only. Zero plaintext stored.
model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  ciphertext     String       @db.Text
  nonce          String
  senderKeyId    String
  recipientKeyId String
  algorithm      String       @default("AES-256-GCM")
  version        Int          @default(1)
  aad            String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}
