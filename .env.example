# ==============================================================================
# ENCTXT Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEPLOYMENT CONFIG (Runtime & Networking)
# ------------------------------------------------------------------------------
# Application runtime environment ('development' | 'production' | 'test')
NODE_ENV=production

# Internal HTTP server listen port
PORT=5000

# Trusted frontend origin for CORS and Cookie access (MUST be explicit in production, NEVER '*')
#
# This is the primary entry in the browser-origin trust boundary. It is NOT only a CORS
# setting: the CSRF origin guard and the WebSocket handshake both enforce against the same
# allowlist, so an origin listed here can drive authenticated state-changing requests.
CORS_ORIGIN=https://app.example.com

# Optional comma-separated ADDITIONAL trusted browser origins (e.g. a Vercel preview
# deployment). Same trust level as CORS_ORIGIN — add an origin here only if you would be
# comfortable with it publishing a user's E2EE identity key. Wildcards are rejected at
# startup in production, as is any entry that is not a valid http(s) origin.
# The localhost development origins are added automatically outside production and are
# NEVER trusted in production.
# ALLOWED_ORIGINS=https://staging.example.com,https://preview.example.com


# ------------------------------------------------------------------------------
# 2. SERVER SECRETS (Backend Only - NEVER Commit to Git or Expose to Client)
# ------------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=prefer
DATABASE_URL=postgresql://enctxt_user:YOUR_STRONG_DATABASE_PASSWORD_HERE@localhost:5432/enctxt_prod?schema=public

# Direct (unpooled) PostgreSQL connection, used ONLY by Prisma migrations and schema tooling.
# Required exclusively when DATABASE_URL points at a transaction-mode connection pooler
# (e.g. a Neon pooled endpoint), because `prisma migrate deploy` cannot run through PgBouncer.
# Leave unset for local development and for any non-pooled deployment.
# NOTE: setting this alone has no effect — the datasource block in server/prisma/schema.prisma
# must declare `directUrl = env("DIRECT_URL")` at the same time. See
# docs/phase-0A5-neon-migration-preparation.md before enabling either half.
# DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require

# Cryptographically random secret for signing and verifying JWT session tokens
# In production, MUST be at least 32 characters long and randomly generated (e.g. `openssl rand -base64 48`)
JWT_SECRET=GENERATE_A_RANDOM_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG_WITH_OPENSSL

# Cookie name for HttpOnly session authentication
SESSION_COOKIE_NAME=enctxt_session

# Session expiration duration in days
SESSION_MAX_AGE_DAYS=7


# ------------------------------------------------------------------------------
# 3. PUBLIC CONFIGURATION (Client-Facing - Bundled into Browser)
# ------------------------------------------------------------------------------
# API Base URL for Vite React client
# In production with reverse proxy forwarding /api to backend, this can be '/api' or your API domain.
# WARNING: Variables prefixed with VITE_ are embedded into public JavaScript bundles.
# NEVER place DATABASE_URL, JWT_SECRET, or PRIVATE_KEY in VITE_* variables!
VITE_API_URL=/api
